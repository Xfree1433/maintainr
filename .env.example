# Database — Postgres connection string
DATABASE_URL="postgresql://maintainr:maintainr_dev@localhost:5434/maintainr"

# Redis (rate limiting, sessions cache if/when wired in)
REDIS_URL="redis://localhost:6381"

# NextAuth — generate AUTH_SECRET with: openssl rand -base64 32
# Production refuses to start if this is missing or still set to the placeholder.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3002"
NEXTAUTH_URL="http://localhost:3002"

# Optional — public /demo auto-login. Off unless ENABLE_DEMO="true" AND
# DEMO_PASSWORD is set (the demo account's password; never commit it).
# DEMO_EMAIL defaults to mark@acme-mfg.com.
# ENABLE_DEMO="true"
# DEMO_PASSWORD=""
# DEMO_EMAIL="mark@acme-mfg.com"
